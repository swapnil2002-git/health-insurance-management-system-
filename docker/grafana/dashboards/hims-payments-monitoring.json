{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "Payment Requests Volume",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(payment_requests_total[1m])) by (payment_method)", "legendFormat": "{{payment_method}}" }
      ]
    },
    {
      "id": 2,
      "title": "Payment Success Volume",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "sum(rate(payment_success_total[1m])) by (payment_method)", "legendFormat": "{{payment_method}}" }
      ]
    },
    {
      "id": 3,
      "title": "Payment Failures Total",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "sum(payment_failures_total) by (failure_reason_category)", "legendFormat": "{{failure_reason_category}}" }
      ]
    },
    {
      "id": 4,
      "title": "Payment Failure Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        { "expr": "(sum(rate(payment_failures_total[1m])) / (sum(rate(payment_requests_total[1m])) + 0.001)) * 100", "legendFormat": "Failure Rate %" }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hims", "payments"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "HIMS - Payments Monitoring",
  "uid": "hims-payments-monitoring"
}