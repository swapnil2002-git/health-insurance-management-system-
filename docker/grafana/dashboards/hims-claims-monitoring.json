{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "Claims Submitted Total",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(claims_submitted_total)", "legendFormat": "Total Submitted" }
      ]
    },
    {
      "id": 2,
      "title": "Claims Adjudication Outcomes",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(claims_adjudicated_total) by (decision)", "legendFormat": "{{decision}}" }
      ]
    },
    {
      "id": 3,
      "title": "Claims Settled Total",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(claims_settled_total) by (payee_type)", "legendFormat": "{{payee_type}}" }
      ]
    },
    {
      "id": 4,
      "title": "Claim Idempotency Conflicts",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(idempotency_conflicts_total{application=\"claims-service\"})", "legendFormat": "Conflicts" }
      ]
    },
    {
      "id": 5,
      "title": "Claim Processing Total Duration (p50, p90, p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "claim_processing_total_duration_seconds{quantile=\"0.95\"}", "legendFormat": "p95 duration" },
        { "expr": "claim_processing_total_duration_seconds{quantile=\"0.9\"}", "legendFormat": "p90 duration" },
        { "expr": "claim_processing_total_duration_seconds{quantile=\"0.5\"}", "legendFormat": "p50 duration" }
      ]
    },
    {
      "id": 6,
      "title": "Claim Adjudication Duration (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "claim_adjudication_duration_seconds{quantile=\"0.95\"}", "legendFormat": "{{decision}} (p95)" },
        { "expr": "claim_adjudication_duration_seconds{quantile=\"0.5\"}", "legendFormat": "{{decision}} (p50)" }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hims", "claims"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "HIMS - Claims Monitoring",
  "uid": "hims-claims-monitoring"
}